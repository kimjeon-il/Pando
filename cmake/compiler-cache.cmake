# Configure once; the launcher carries the owned environment into later builds.
find_program(_pando_node node REQUIRED)
execute_process(COMMAND "${_pando_node}" "${CMAKE_CURRENT_LIST_DIR}/../tools/worktree-storage.mjs" --compiler-env
    RESULT_VARIABLE _pando_cache_result OUTPUT_VARIABLE _pando_cache_json ERROR_VARIABLE _pando_cache_error)
if(NOT _pando_cache_result EQUAL 0)
    message(FATAL_ERROR "Compiler cache configuration failed: ${_pando_cache_error}")
endif()
string(JSON _pando_cache_tool ERROR_VARIABLE _pando_cache_missing GET "${_pando_cache_json}" RUSTC_WRAPPER)
if(NOT _pando_cache_missing)
    if(CMAKE_CXX_COMPILER_LAUNCHER AND NOT CMAKE_CXX_COMPILER_LAUNCHER STREQUAL _pando_cache_tool)
        message(FATAL_ERROR "Compiler launcher conflicts with activated Pando cache")
    endif()
    set(_pando_cache_launcher "${CMAKE_COMMAND}" -E env)
    foreach(_key SCCACHE_DIR SCCACHE_CACHE_SIZE SCCACHE_SERVER_PORT SCCACHE_BASEDIRS)
        string(JSON _value ERROR_VARIABLE _missing GET "${_pando_cache_json}" "${_key}")
        if(NOT _missing)
            list(APPEND _pando_cache_launcher "${_key}=${_value}")
        endif()
    endforeach()
    if(EMSCRIPTEN)
        list(APPEND _pando_cache_launcher "EM_COMPILER_WRAPPER=${_pando_cache_tool}")
    else()
        list(APPEND _pando_cache_launcher "${_pando_cache_tool}")
    endif()
    set(CMAKE_CXX_COMPILER_LAUNCHER "${_pando_cache_launcher}")
    set(CMAKE_C_COMPILER_LAUNCHER "${_pando_cache_launcher}")
endif()
