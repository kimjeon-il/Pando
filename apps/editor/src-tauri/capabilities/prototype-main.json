{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "prototype-main",
  "description": "Only fixed prototype storage and user-selected project dialogs.",
  "windows": [
    "main", "library-geometry-*"
  ],
  "permissions": [
    "allow-write-diagnostic-report",
    "allow-begin-document-write",
    "allow-append-document-chunk",
    "allow-finish-document-write",
    "allow-begin-document-read",
    "allow-read-document-chunk",
    "allow-abort-document-transfer",
    "allow-library-open", "allow-library-read-entity", "allow-library-commit",
    "allow-library-sync", "allow-library-publish", "allow-library-conflict", "allow-library-open-geometry", "allow-library-read-external-changes", "allow-library-read-candidate"
  ]
}
