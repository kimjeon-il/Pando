{
  "name": "@pandolab/web-shell-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "stage": "node stage.mjs",
    "stage:map-data": "node stage.mjs --profile=map-data",
    "tauri": "tauri",
    "build:windows": "node packaged-artifacts.mjs --fetch --platform=windows --mode=offline",
    "test:native": "node packaged-artifacts.mjs --fetch --platform=windows --mode=development --test-native",
    "dev:windows": "node dev.mjs --native=windows",
    "dev:server": "node ../../scripts/frontend-dev-server.mjs --product=editor",
    "build:verification:windows": "node packaged-artifacts.mjs --fetch --platform=windows --mode=verification",
    "stage:verification": "node stage.mjs --verification"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
