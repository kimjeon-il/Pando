  "decisionPolicy": "These are planned treatments, not evidence that removal is currently safe. A file may be removed only when its executable and source-inspection blockers are resolved and canonical tests pass.",
  "categories": {
    "gis-interop": {
      "phase": "R4-E1",
      "disposition": "extract-or-reuse",
      "target": "tools/gis or tests/helpers",
      "reason": "A GIS/GeoPackage or historic source/Worker contract may contain distinct reusable behavior. Check for an existing canonical equivalent before extraction; then retire editor-only wiring.",
      "blockingGate": "Worker RPC and/or GeoPackage read/write fixtures + source/date/geometry parity"
    },
    "core-fixture": {
      "phase": "R4-E2",
      "disposition": "migrate-test-coverage",
      "target": "shared/Core runtime or tests/helpers",
      "reason": "Legacy app command, persistence or geometry orchestration is exercised by tests. Preserve only distinct data/Core invariants in canonical tests, not the editor facade.",
      "blockingGate": "Core/WASM acknowledgement, mutation atomicity, temporal/source semantics and existing feature parity"
    },
    "canonical-forwarder": {
      "phase": "R4-E5",
      "disposition": "remove-forwarding-shim",
      "target": "existing tools/gis canonical implementation",
      "reason": "A legacy re-export/compatibility owner remains after earlier GIS data/spatial extraction. Redirect consumers to canonical files, then delete.",
      "blockingGate": "Identical exports and GIS numerical/geometry/source parity after direct owner imports"
    },
    "retired-worker": {
      "phase": "R4-E4",
      "disposition": "remove-editor-worker",
      "target": "none; migrate valid tests to canonical Worker where necessary",
      "reason": "Worker exists only to orchestrate retired editor UI tasks. Do not preserve the worker merely for its own legacy test, but retain independent Core/WASM facts.",
      "blockingGate": "No active worker URLs or test/runtime imports; surviving Viewer/GIS Worker tests pass"
    },
    "retired-ui": {
      "phase": "R4-E4",
      "disposition": "remove-editor-ui",
      "target": "none; tests may use Viewer/shared or canonical GIS owners",
      "reason": "Legacy editor interface, direct manipulation, or app-only presenter/controller. Retire old UI behavior and migrate only reusable assertions to Viewer/Core checks.",
      "blockingGate": "No active runtime/test/helper imports or source-inspection path; E6/E7 Viewer/Windows gates pass"
    }
  },
