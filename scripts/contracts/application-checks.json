        "scripts/lib/frontend-build.mjs",
        "scripts/check-version.mjs"
      ],
      "argv": [
        "node",
        "scripts/check-version.mjs"
      ],
      "requires": [],
      "testPatterns": []
    },
    {
      "id": "worker-contracts",
      "kind": "command",
      "inputs": [
