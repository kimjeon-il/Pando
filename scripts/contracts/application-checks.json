        "tests/browser/**/gpu-*.spec.mjs",
        "tests/browser/**/country-*.spec.mjs",
        "tests/browser/**/renderer-*.spec.mjs"
      ],
      "inputs": [
        "src/**/gpu-*.js",
        "src/**/map-display-*.js",
        "src/**/render-*.js",
        "src/**/map-visual-*.js",
        "src/rendering/workers/canvas-render-worker.js",
        "src/rendering/workers/gpu-mesh-worker.js"
      ],
      "requires": [
        "generated",
        "core"
      ]
    },
    {
