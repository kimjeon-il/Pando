        "tests/browser/**/soviet-*.spec.mjs",
        "tests/browser/**/*-benchmark.spec.mjs",
        "tests/browser/**/*-memory.spec.mjs",
        "tests/browser/**/performance-*.spec.mjs",
        "tests/browser/rendering/canvas-globe-performance.spec.mjs",
        "tests/browser/runtime/p3-remote-preview.spec.mjs",
        "tests/browser/document/codespaces-live.spec.mjs"
      ],
      "inputs": []
    },
    {
      "id": "object-contracts",
      "kind": "unit",
      "testPatterns": [
        "tests/unit/**/object-*.test.mjs",
        "tests/unit/**/territorial-*.test.mjs",
        "tests/unit/**/project-*.test.mjs",
        "tests/unit/**/temporal*.test.mjs",
        "tests/unit/**/timeline*.test.mjs",
        "tests/unit/**/generic-*.test.mjs",
