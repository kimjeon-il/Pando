      "inputs": [
        "src/**",
        "scripts/lib/frontend-*.mjs",
        "scripts/frontend-dev-server.mjs",
        "tools/data/worktree-storage.mjs"
      ]
    },
    {
      "id": "place-contracts",
      "kind": "unit",
      "testPatterns": [
        "tests/unit/**/place-*.test.mjs"
      ],
      "inputs": [
        "src/**/place-*.js",
        "src/rendering/territorial-labels.js",
        "assets/data/places/**"
      ]
    },
    {
