      "id": "deferred-builtin-timeline",
      "kind": "browser",
      "mode": "manual",
      "reason": "User-deferred unresolved cases: July 1953 transition completion and injected-failure previous-year click. Preserve both cases without automatic rerun or a passing status; execute only when explicitly resumed.",
      "testPatterns": [
        "tests/browser/ui/deferred-builtin-timeline.spec.mjs"
      ],
      "inputs": [],
      "requires": [
        "generated",
        "core"
      ]
    },
    {
      "id": "wasm-domain-geometry",
      "kind": "command",
      "mode": "manual",
      "reason": "Focused geometry ABI verification after a source-matched CI WASM build.",
      "inputs": [
        "src/**/native/**",
        "tools/build/native/**",
        "config/core-source-roots.json"
      ],
      "argv": [
        "node",
        "--test",
        "tests/native/document/p5-country-contact-wasm.test.mjs",
        "tests/native/document/p5-boundary-split-wasm.test.mjs",
        "tests/native/document/p5-polygon-mesh-wasm.test.mjs"
