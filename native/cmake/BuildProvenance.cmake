if(NOT DEFINED PANDO_PROVENANCE_ROOT OR NOT DEFINED PANDO_PROVENANCE_OUTPUT)
    message(FATAL_ERROR "Build provenance requires source root and output directory")
endif()
file(TO_CMAKE_PATH "${PANDO_PROVENANCE_ROOT}" PANDO_PROVENANCE_ROOT)
file(TO_CMAKE_PATH "${PANDO_PROVENANCE_OUTPUT}" PANDO_PROVENANCE_OUTPUT)
set(provenance_sources native shared)
# Native runtimes depend on canonical Web modules outside native/. A source
# edit must invalidate the executable even before regenerating the artifacts.
foreach(source_manifest IN ITEMS native/app/reference-web/manifest.json native/assets/geometry/current/manifest.json)
    file(READ "${PANDO_PROVENANCE_ROOT}/${source_manifest}" runtime_manifest)
    string(JSON runtime_schema GET "${runtime_manifest}" schemaVersion)
    string(JSON runtime_count LENGTH "${runtime_manifest}" files)
    if(NOT runtime_schema EQUAL 2 OR runtime_count LESS 1)
        message(FATAL_ERROR "Cannot establish native runtime source ownership: ${source_manifest}")
    endif()
    math(EXPR runtime_last "${runtime_count}-1")
    foreach(index RANGE ${runtime_last})
        string(JSON runtime_path GET "${runtime_manifest}" files ${index} path)
        if(runtime_path STREQUAL "" OR IS_ABSOLUTE "${runtime_path}" OR
           runtime_path MATCHES "(^|/)\\.\\.(/|$)" OR runtime_path MATCHES "[\\\\;]")
            message(FATAL_ERROR "Runtime provenance source must stay inside the repository")
        endif()
        list(APPEND provenance_sources ":(literal)${runtime_path}")
    endforeach()
endforeach()
find_program(PANDO_PROVENANCE_GIT git REQUIRED)
execute_process(COMMAND "${PANDO_PROVENANCE_GIT}" -C "${PANDO_PROVENANCE_ROOT}" rev-parse HEAD
    OUTPUT_VARIABLE PANDO_BUILD_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot establish build commit")
endif()
execute_process(COMMAND "${PANDO_PROVENANCE_GIT}" -C "${PANDO_PROVENANCE_ROOT}" diff --binary HEAD -- ${provenance_sources}
    OUTPUT_VARIABLE dirty_diff ERROR_VARIABLE diagnostics RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot establish dirty source diff: ${diagnostics}")
endif()
execute_process(COMMAND "${PANDO_PROVENANCE_GIT}" -c core.quotepath=false -C "${PANDO_PROVENANCE_ROOT}" ls-files --others --exclude-standard -- ${provenance_sources}
    OUTPUT_VARIABLE untracked OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot establish untracked source files")
endif()
string(REPLACE "\n" ";" untracked_files "${untracked}")
set(dirty_material "${dirty_diff}")
foreach(path IN LISTS untracked_files)
    if(NOT path STREQUAL "")
        file(SHA256 "${PANDO_PROVENANCE_ROOT}/${path}" digest)
        string(APPEND dirty_material "\n${path}:${digest}")
    endif()
endforeach()
string(SHA256 PANDO_BUILD_DIRTY_SOURCE_HASH "${dirty_material}")
string(SHA256 PANDO_BUILD_SOURCE_HASH "${PANDO_BUILD_COMMIT}\n${PANDO_BUILD_DIRTY_SOURCE_HASH}")
if(dirty_material STREQUAL "")
    set(PANDO_BUILD_DIRTY false)
else()
    set(PANDO_BUILD_DIRTY true)
endif()
if(PANDO_PROVENANCE_CHECK)
    if(NOT EXISTS "${PANDO_PROVENANCE_OUTPUT}/build-provenance.json")
        message(FATAL_ERROR "Local executable has no build provenance; rebuild it")
    endif()
    file(READ "${PANDO_PROVENANCE_OUTPUT}/build-provenance.json" previous)
    string(JSON previous_commit GET "${previous}" commit)
    string(JSON previous_dirty_hash GET "${previous}" dirtySourceHash)
    string(JSON previous_root GET "${previous}" sourceRoot)
    if(NOT previous_commit STREQUAL PANDO_BUILD_COMMIT OR
       NOT previous_dirty_hash STREQUAL PANDO_BUILD_DIRTY_SOURCE_HASH OR
       NOT previous_root STREQUAL PANDO_PROVENANCE_ROOT)
        message(FATAL_ERROR "Local executable was built from different source; rebuild it")
    endif()
    if(NOT DEFINED PANDO_PROVENANCE_EXECUTABLE OR NOT EXISTS "${PANDO_PROVENANCE_EXECUTABLE}")
        message(FATAL_ERROR "Local executable is missing; rebuild it")
    endif()
    string(JSON previous_executable_hash GET "${previous}" executableSha256)
    file(SHA256 "${PANDO_PROVENANCE_EXECUTABLE}" executable_hash)
    if(NOT previous_executable_hash STREQUAL executable_hash)
        message(FATAL_ERROR "Local executable does not match its build provenance; rebuild it")
    endif()
    message(STATUS "Local build provenance matches ${PANDO_BUILD_COMMIT} ${PANDO_BUILD_DIRTY_SOURCE_HASH}")
    return()
endif()
if(PANDO_PROVENANCE_FINALIZE)
    if(NOT EXISTS "${PANDO_PROVENANCE_OUTPUT}/build-provenance.pending.json")
        message(FATAL_ERROR "No prepared build provenance is available")
    endif()
    file(READ "${PANDO_PROVENANCE_OUTPUT}/build-provenance.pending.json" pending)
    string(JSON pending_source_hash GET "${pending}" sourceHash)
    string(JSON pending_root GET "${pending}" sourceRoot)
    if(NOT pending_source_hash STREQUAL PANDO_BUILD_SOURCE_HASH OR
       NOT pending_root STREQUAL PANDO_PROVENANCE_ROOT)
        message(FATAL_ERROR "Source changed during the build; rebuild before recording provenance")
    endif()
    if(NOT DEFINED PANDO_PROVENANCE_EXECUTABLE OR NOT EXISTS "${PANDO_PROVENANCE_EXECUTABLE}")
        message(FATAL_ERROR "Cannot record provenance without the linked executable")
    endif()
    file(SHA256 "${PANDO_PROVENANCE_EXECUTABLE}" executable_hash)
    string(JSON receipt SET "${pending}" executableSha256 "\"${executable_hash}\"")
    file(WRITE "${PANDO_PROVENANCE_OUTPUT}/build-provenance.json.finalizing" "${receipt}\n")
    file(RENAME "${PANDO_PROVENANCE_OUTPUT}/build-provenance.json.finalizing"
                "${PANDO_PROVENANCE_OUTPUT}/build-provenance.json")
    return()
endif()
file(MAKE_DIRECTORY "${PANDO_PROVENANCE_OUTPUT}")
set(json "{\n  \"commit\": \"${PANDO_BUILD_COMMIT}\",\n  \"dirty\": ${PANDO_BUILD_DIRTY},\n  \"dirtySourceHash\": \"${PANDO_BUILD_DIRTY_SOURCE_HASH}\",\n  \"sourceHash\": \"${PANDO_BUILD_SOURCE_HASH}\",\n  \"sourceRoot\": \"${PANDO_PROVENANCE_ROOT}\"\n}\n")
set(header "#pragma once\n#define PANDO_BUILD_COMMIT \"${PANDO_BUILD_COMMIT}\"\n#define PANDO_BUILD_DIRTY_SOURCE_HASH \"${PANDO_BUILD_DIRTY_SOURCE_HASH}\"\n#define PANDO_BUILD_SOURCE_HASH \"${PANDO_BUILD_SOURCE_HASH}\"\n")
# Configure/pre-build capture prepares the header, but cannot certify an older
# executable. Only the executable target's successful POST_BUILD finalizes it.
file(CONFIGURE OUTPUT "${PANDO_PROVENANCE_OUTPUT}/build-provenance.pending.json" CONTENT "${json}" @ONLY)
file(CONFIGURE OUTPUT "${PANDO_PROVENANCE_OUTPUT}/buildprovenance.h" CONTENT "${header}" @ONLY)
